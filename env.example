# Copy to .env (or set as Colab/Streamlit secrets). Never commit the real file.
JWT_SECRET=change-me-to-a-long-random-string
OTP_SECRET=change-me-too
DB_PATH=franchiseops.db            # on Colab use e.g. /content/drive/MyDrive/franchiseops.db
SMTP_USER=yourgmail@gmail.com
SMTP_APP_PASSWORD=your-16-char-gmail-app-password
REQUIRE_LOGIN_OTP=false            # true = OTP on every login (2-step)
DEV_SHOW_OTP=true                  # true = show OTP on screen if email isn't configured (dev only)
ADMIN_EMAIL=admin@franchiseops.ai
ADMIN_PASSWORD=Admin@12345         # seeded once on first run; change immediately
